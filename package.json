{
    "name": "splatroom",
    "version": "1.0.0",
    "author": "摄影师黄Sir <1924705842@qq.com>",
    "homepage": "https://github.com/photographer-huangsir/splatroom",
    "description": "3D Gaussian Splat Editor - 调色与后期工作流",
    "keywords": [
        "playcanvas",
        "ply",
        "gaussian",
        "splat",
        "editor"
    ],
    "license": "MIT",
    "main": "electron-main.js",
    "scripts": {
        "build": "rollup -c",
        "watch": "rollup -c -w",
        "serve": "serve dist -C",
        "develop": "cross-env BUILD_TYPE=debug concurrently --kill-others \"npm run watch\" \"npm run serve\"",
        "develop:auto-launch": "concurrently --kill-others \"xdg-open 'http://localhost:3000/'\" \"npm run watch\" \"npm run serve\"",
        "electron": "electron .",
        "pack": "npm run build && electron-builder --dir",
        "dist": "npm run build && electron-builder",
        "dist:win": "npm run build && electron-builder --win portable",
        "lint": "eslint src",
        "lint:locales": "node scripts/check-locales.mjs"
    },
    "build": {
        "appId": "com.huangsir.splatroom",
        "productName": "SplatRoom",
        "directories": {
            "output": "release"
        },
        "files": [
            "dist/**/*",
            "static/**/*",
            "electron-main.js",
            "electron-preload.js",
            "package.json"
        ],
        "win": {
            "target": [
                {
                    "target": "portable",
                    "arch": ["x64"]
                }
            ],
            "icon": "static/icons/icon.ico"
        },
        "portable": {
            "artifactName": "SplatRoom-${version}.exe"
        }
    },
    "engines": {
        "node": ">=20.19.0"
    },
    "devDependencies": {
        "@playcanvas/eslint-config": "2.1.0",
        "@playcanvas/splat-transform": "3.1.0",
        "@playcanvas/pcui": "6.1.4",
        "@rollup/plugin-alias": "6.0.0",
        "@rollup/plugin-image": "3.0.3",
        "@rollup/plugin-json": "6.1.0",
        "@rollup/plugin-node-resolve": "16.0.3",
        "@rollup/plugin-strip": "3.0.4",
        "@rollup/plugin-terser": "1.0.0",
        "@rollup/plugin-typescript": "12.3.0",
        "@types/wicg-file-system-access": "2023.10.7",
        "@typescript-eslint/eslint-plugin": "8.64.0",
        "@typescript-eslint/parser": "8.64.0",
        "autoprefixer": "10.5.4",
        "concurrently": "10.0.3",
        "cors": "2.8.6",
        "cross-env": "10.1.0",
        "electron": "33.4.0",
        "electron-builder": "25.1.8",
        "eslint": "10.7.0",
        "eslint-import-resolver-typescript": "4.4.5",
        "globals": "17.7.0",
        "i18next": "26.3.6",
        "i18next-browser-languagedetector": "8.2.1",
        "i18next-http-backend": "4.0.0",
        "mediabunny": "1.50.8",
        "playcanvas": "2.20.6",
        "postcss": "8.5.19",
        "rollup": "4.62.2",
        "rollup-plugin-scss": "4.0.1",
        "sass": "1.101.0",
        "serve": "14.2.6",
        "tslib": "2.8.1",
        "typescript": "6.0.3"
    }
}
