{
    "name": "splatroom",
    "version": "3.23.2",
    "author": "摄影师黄Sir <1924705842@qq.com>",
    "homepage": "https://github.com/photographer-huangsir/splatroom",
    "description": "3D Gaussian Splat Editor - 调色与后期工作流",
    "keywords": [
        "playcanvas",
        "ply",
        "gaussian",
        "splat",
        "editor"
    ],
    "license": "MIT",
    "main": "electron-main.js",
    "scripts": {
        "build": "rollup -c",
        "watch": "rollup -c -w",
        "serve": "serve dist -C",
        "develop": "cross-env BUILD_TYPE=debug concurrently --kill-others \"npm run watch\" \"npm run serve\"",
        "develop:auto-launch": "concurrently --kill-others \"xdg-open 'http://localhost:3000/'\" \"npm run watch\" \"npm run serve\"",
        "electron": "electron .",
        "pack": "npm run build && electron-builder --dir",
        "dist": "npm run build && electron-builder",
        "dist:win": "npm run build && electron-builder --win portable",
        "lint": "eslint src",
        "lint:locales": "node scripts/check-locales.mjs",
        "typecheck": "tsc --noEmit",
        "audit": "node scripts/audit-code.mjs",
        "check": "npm run typecheck && npm run lint && npm run lint:locales && npm run audit",
        "verify:diag": "node --no-warnings --experimental-strip-types docs/verify/verify-render-diagnostics.mts",
        "verify:serve": "serve dist -C -l 3100",
        "verify:toolbar": "node docs/verify/verify-selection-toolbar.cjs http://localhost:3100/",
        "verify:selection": "node docs/verify/verify-selection-depth.cjs http://localhost:3100/",
        "verify:render": "node docs/verify/verify-model-renders.cjs http://localhost:3100/",
        "verify:overlay": "node docs/verify/verify-overlay-missing-order-texture.cjs http://localhost:3100/",
        "postinstall": "node scripts/apply-patches.js",
        "patched": "node scripts/apply-patches.js"
    },
    "build": {
        "appId": "com.huangsir.splatroom",
        "productName": "SplatRoom",
        "directories": {
            "output": "release"
        },
        "electronDist": "node_modules/electron/dist",
        "files": [
            "dist/**/*",
            "static/**/*",
            "electron-main.js",
            "electron-preload.js",
            "package.json"
        ],
        "win": {
            "target": [
                {
                    "target": "portable",
                    "arch": [
                        "x64"
                    ]
                }
            ],
            "icon": "static/icons/icon.ico"
        },
        "portable": {
            "artifactName": "SplatRoom-${version}.exe"
        }
    },
    "engines": {
        "node": ">=20.19.0"
    },
    "devDependencies": {
        "@playcanvas/eslint-config": "2.1.0",
        "@rollup/plugin-alias": "6.0.0",
        "@rollup/plugin-image": "3.0.3",
        "@rollup/plugin-json": "6.1.0",
        "@rollup/plugin-node-resolve": "16.0.3",
        "@rollup/plugin-strip": "3.0.4",
        "@rollup/plugin-terser": "1.0.0",
        "@rollup/plugin-typescript": "12.3.0",
        "@types/wicg-file-system-access": "2023.10.7",
        "@typescript-eslint/eslint-plugin": "8.64.0",
        "@typescript-eslint/parser": "8.64.0",
        "autoprefixer": "10.5.4",
        "concurrently": "^10.0.4",
        "cross-env": "10.1.0",
        "electron": "43.4.0",
        "electron-builder": "26.15.3",
        "eslint": "10.7.0",
        "eslint-import-resolver-typescript": "4.4.5",
        "globals": "17.7.0",
        "postcss": "^8.5.26",
        "rollup": "4.62.2",
        "rollup-plugin-scss": "4.0.1",
        "sass": "1.101.0",
        "serve": "14.2.6",
        "tslib": "2.8.1",
        "typescript": "6.0.3"
    },
    "dependencies": {
        "@playcanvas/pcui": "6.1.4",
        "@playcanvas/splat-transform": "^3.4.0",
        "i18next": "26.3.6",
        "i18next-browser-languagedetector": "8.2.1",
        "i18next-http-backend": "4.0.0",
        "mediabunny": "1.50.8",
        "playcanvas": "2.21.3"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/ByronHuangsir/SplatRoom.git"
    },
    "bugs": {
        "url": "https://github.com/ByronHuangsir/SplatRoom/issues"
    }
}
