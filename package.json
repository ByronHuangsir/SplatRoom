{
    "name": "splatroom",
    "version": "3.3.4",
    "author": "鎽勫奖甯堥粍Sir <1924705842@qq.com>",
    "homepage": "https://github.com/photographer-huangsir/splatroom",
    "description": "3D Gaussian Splat Editor - 璋冭壊涓庡悗鏈熷伐浣滄祦",
    "keywords": [
        "playcanvas",
        "ply",
        "gaussian",
        "splat",
        "editor"
    ],
    "license": "MIT",
    "main": "electron-main.js",
    "scripts": {
        "build": "rollup -c",
        "watch": "rollup -c -w",
        "serve": "serve dist -C",
        "develop": "cross-env BUILD_TYPE=debug concurrently --kill-others \"npm run watch\" \"npm run serve\"",
        "develop:auto-launch": "concurrently --kill-others \"xdg-open 'http://localhost:3000/'\" \"npm run watch\" \"npm run serve\"",
        "electron": "electron .",
        "pack": "npm run build && electron-builder --dir",
        "dist": "npm run build && electron-builder",
        "dist:win": "npm run build && electron-builder --win portable",
        "lint": "eslint src",
        "lint:locales": "node scripts/check-locales.mjs",
        "typecheck": "tsc --noEmit",
        "audit": "node scripts/audit-code.mjs",
        "check": "npm run typecheck && npm run lint && npm run lint:locales && npm run audit",
        "verify:diag": "node --no-warnings --experimental-strip-types docs/verify/verify-render-diagnostics.mts",
        "verify:serve": "serve dist -C -l 3100",
        "verify:toolbar": "node docs/verify/verify-selection-toolbar.cjs http://localhost:3100/",
        "verify:selection": "node docs/verify/verify-selection-depth.cjs http://localhost:3100/",
        "verify:render": "node docs/verify/verify-model-renders.cjs http://localhost:3100/",
        "verify:overlay": "node docs/verify/verify-overlay-missing-order-texture.cjs http://localhost:3100/",
        "postinstall": "node scripts/apply-patches.js"
    },
    "build": {
        "appId": "com.huangsir.splatroom",
        "productName": "SplatRoom",
        "directories": {
            "output": "release"
        },
        "electronDist": "node_modules/electron/dist",
        "files": [
            "dist/**/*",
            "static/**/*",
            "electron-main.js",
            "electron-preload.js",
            "package.json"
        ],
        "win": {
            "target": [
                {
                    "target": "portable",
                    "arch": [
                        "x64"
                    ]
                }
            ],
            "icon": "static/icons/icon.ico"
        },
        "portable": {
            "artifactName": "SplatRoom-${version}.exe"
        }
    },
    "engines": {
        "node": ">=20.19.0"
    },
